# Copy to .env and fill in. Never commit .env.

# --- Liara ---
# Liara Console -> API section
LIARA_API_TOKEN=
# Team accounts only (sent as ?teamID=... on every request). Leave empty for a personal account.
LIARA_TEAM_ID=
LIARA_API_URL=https://api.liara.ir
LIARA_DNS_URL=https://dns-service.iran.liara.ir

# --- LLM (BoxAPI, OpenAI-compatible) ---
LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
LLM_API_KEY=
# Main agent model. Run `python scripts/smoke_test.py` to check which models support tool calling.
LLM_MODEL=gpt-5.6-sol
# Tried in order if the main model fails (e.g. not available on your account).
LLM_FALLBACK_MODELS=gpt-5.6-terra,gpt-5-mini

# --- Assistant behaviour ---
# Seconds between background health checks for watched apps
MONITOR_INTERVAL_SEC=120
AUDIT_LOG_PATH=data/audit.jsonl
# Optional: a default app so you don't have to name it every time
DEFAULT_APP=
